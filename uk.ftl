orgcreate-createbutton = Створити

faq-orgs-whatare-q = Що таке Coggle Організації?
faq-orgs-whatare-a =
    <p data-l10n-name='p1'>Coggle Організації відокремлюють ваші особисті діаграми
      від тих, що належать вашій компанії. Розділяючи особисте й робоче,
      ви отримуєте більше контролю над даними компанії, що зберігаються в Coggle,
      зокрема над тим, коли і як ними діляться ваші працівники.</p>

faq-orgs-whofor-q = Для кого Coggle Організації?
faq-orgs-whofor-a =
    <p data-l10n-name='p1'>Coggle Організації створено для команд, яким потрібен
      більший контроль над даними, що вони вводять у Coggle, або які мають тримати
      особисті дані окремо. Їх успішно використовують приватні компанії,
      державні установи, школи й університети, щоб допомогти групам
      безпечно співпрацювати.</p>
    <p data-l10n-name='p2'>Будь-якій групі, якій потрібен більший контроль над спільним доступом до
      діаграм — для дотримання нормативних вимог чи внутрішніх правил, —
      знадобляться Coggle Організації.</p>

faq-orgs-features-q = Які основні можливості Coggle Організації?
faq-orgs-features-a =
    <p data-l10n-name='p1'><b>Панель адміністратора</b>: повний контроль над діаграмами,
      створеними учасниками вашої організації, зокрема відновлення видалених діаграм.
    </p>
    <p data-l10n-name='p2'><b>Контроль даних</b>: обмежте спільний доступ до даних лише
      межами вашої організації.</p>
    <p data-l10n-name='p3'><b>Масовий експорт</b>: експортуйте всі діаграми організації для резервного
      копіювання чи нормативних цілей.</p>
    <p data-l10n-name='p4'><b>Централізована оплата</b>: оплачуйте кілька підписок Awesome
      в одному місці й скасовуйте підписки, коли учасники приходять до
      організації чи залишають її.</p>

faq-orgs-awesome-q = Як Coggle Організації пов'язані з Coggle Awesome?
faq-orgs-awesome-a =
    <p data-l10n-name='p1'>Coggle Організації — чудовий спосіб централізувати оплату й керування
      ліцензіями для кількох підписок Coggle Awesome.</p>
    <p data-l10n-name='p2'>Кожен користувач вашої організації автоматично отримує Coggle Awesome,
      коли працює з діаграмами в робочому просторі організації. Це всі
      чудові можливості, зокрема приватні діаграми, режим презентації,
      розширена палітра кольорів і завантаження зображень високої роздільності.</p>

faq-orgs-billing-q = Як працює оплата Coggle Організацій?
faq-orgs-billing-a = Coggle Організації коштують ${$pricePerMemberPerMonth} за учасника на місяць. Додавати
  й видаляти учасників можна будь-коли на панелі керування організації.

faq-orgs-edu-q = Чи є спеціальні ціни для освіти?
faq-orgs-edu-a = Так! Напишіть нам на education@coggle.it, щоб дізнатися більше.

faq-orgs-more-q = У мене ще є запитання...
faq-orgs-more-a = Запитайте нас! Напишіть на orgs@coggle.it, і ми з радістю допоможемо :)


# About Coggle (/about)
about-hello2-title = Привіт!
about-hello2-p1 =
    <b>Coggle дає вам зрозумілий спосіб ділитися складною інформацією
    й розуміти її. Це спільний документ, що спрощує складне, і спільний
    робочий простір, який допомагає вашій команді працювати разом
    ефективніше.</b>
about-hello2-p2 =
    Це безкоштовно, і ми обіцяємо, що так буде завжди, але ми також обіцяємо
    якнайкраще дбати про ваші дані, робити резервні копії й серйозно ставитися
    до безпеки.
about-hello2-p3 =
    Наша місія — назавжди змінити те, як люди працюють і співпрацюють,
    зробити вас продуктивнішими, полегшити обмін інформацією з іншими
    й робити це красиво та приємно у використанні.



about-what-is-mindmapping-title = Що таке ментальні карти?
about-what-is-mindmapping =
    Ментальна карта — це простий спосіб наочно й природно представити тему.
    Вона починається з однієї або кількох центральних тем, а потім раз у раз
    розгалужується, розкладаючи інформацію на ієрархію складових.<br>
    Елементи ментальної карти можна розташовувати в просторі й оформлювати
    різним розміром і кольором, щоб краще запам'ятовувати й пригадувати.
    Ментальні карти мають багато назв: інтелект-карти, концептуальні карти,
    діаграми-павуки, схеми мозкового штурму тощо, але для всіх них можна
    використовувати Coggle!



about-who-is-mindmapping-for-title = Для кого ментальні карти?
about-who-is-mindmapping-for =
