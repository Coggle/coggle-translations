/* De tekst van de knop om factuurgegevens op te slaan verandert afhankelijk van de context:
 * wanneer een gebruiker zich aanmeldt bij Awesome, „koopt” hij een abonnement; wanneer hij
 * een Organisatie aanmaakt, „maakt” hij een organisatie aan; en wanneer hij
 * de factuurgegevens wijzigt, „werkt” hij deze bij.
 */
<settingsSubmitButton {
  purchase: “aankoop”,
   *submit: “verzenden”,
    update: “bijwerken”,
    create: “aanmaken”,
}>

<billingPeriod {
           *permonth: “per maand”,
   permemberpermonth: “per lid per maand”,
             peryear: “per jaar”
}>

<billing-header “”"
    <h3>Factuurgegevens</h3>
    <div>We denken dat je je Coggle-abonnement geweldig zult vinden, maar mocht je om welke reden dan ook niet helemaal tevreden zijn, neem dan contact op via <b>hello@coggle.it</b> en we lossen het op.</div>
“”">
<billing-on-file “”"
  <p>De kaart die bij ons voor u geregistreerd staat, eindigt op <b>{{ $cardEndsIn }}</b> en verloopt op <b>{{ $cardExpires }}</b>.</p>
  <p>De postcode die bij ons voor u geregistreerd staat, is <b>{{ $addressZip }}</b>. <a>Kaartgegevens bewerken</a></p>
“”">
<billing-ok-button “{{ settingsSubmitButton[$submit] }}”>
<billing-charge-description “”"
    We brengen je het volgende in rekening
    <span>{{ $product.price }}</span>
    <span>(VS) {{ billingPeriod[$product.periodKey] }}</span>
“”">
<billing-remove-card “Mijn kaartgegevens verwijderen”>

<billing-form “”"
  <div>
    <label>Kaartnummer</label>
    <input>
  </div>
  <div>
    <label>Vervaldatum</label>
    <input> <input> <input placeholder="MM/JJJJ" title="Vervaldatum">
  </div>
  <div>
    <label>Beveiligingscode</label>
    <input title="De laatste 3 cijfers van de code in het handtekeningvakje op uw kaart.">
  </div>
  <div>
    <label>Naam op de kaart</label>
    <input placeholder="Naam op de kaart">
  </div>
  <div>
    <label>Factuuradres</label>
    <input placeholder="Adresregel 1">
    <input placeholder="Adresregel 2">
  </div>
  <div>
    <input placeholder="Plaats">
  </div>
  <div>
    <input placeholder="Postcode">
  </div>
“”">
<billing-choose-country “Kies land”>
<billing-weusestripe “We gebruiken <a>Stripe</a> om betalingen veilig te verwerken: je kaartgegevens worden nooit via onze servers verzonden.”>

<cancel-really “”"
